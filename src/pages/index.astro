---
import Base from '../layouts/Base.astro';
import ContactLinks from '../components/ContactLinks.astro';
import Icon from '../components/Icon.astro';

const experience = [
  {
    role: 'Senior DevOps Engineer · Cloud Platform',
    company: 'Cardo AI',
    period: 'February 2026 - Present',
    summary: 'I help build and operate the cloud platform behind a fintech product used by institutional clients in Europe and the US.',
    contributions: [
      'Automate infrastructure and software delivery across AWS and Kubernetes.',
      'Build security checks, policy as code, and compliance readiness into everyday engineering.',
      'Improve cloud cost management and automate repetitive work.',
    ],
    paragraphs: [
      'Joining Cardo AI marked an exciting new chapter for me. Moving into fintech meant learning how to build and operate platforms where reliability, security, and trust are part of every decision. I work across a multi-region AWS environment and its Kubernetes platforms, helping provide the foundation for a cloud-native product used by institutional clients in Europe and the US.',
      'A large part of my work is about making the platform easier to use and safer to change. I have built automation around Terraform, GitOps, GitHub Actions, and AWS CodeBuild, while also improving how security and compliance are embedded in everyday engineering rather than treated as separate activities. I have worked on policy as code, SOC2 readiness, and FinOps initiatives, and I continue to explore practical uses of n8n and AI to remove repetitive work and leave more room for thoughtful engineering.',
    ],
  },
  {
    role: 'DevOps Engineer · Team Lead',
    company: 'Florence Consulting Group',
    period: 'December 2019 - January 2026',
    summary: 'I grew from a junior engineer into a DevOps team lead, helping organizations modernize their infrastructure and how they deliver software.',
    contributions: [
      'Designed infrastructure across cloud, hybrid, and on-premises environments.',
      'Introduced Kubernetes, automated delivery, and tools to understand how systems behave.',
      'Mentored engineers and worked with stakeholders on technical strategy.',
    ],
    paragraphs: [
      'Florence Consulting Group was my first real job, and I will always be grateful to its CEOs, Iacopo and Niccolò, for giving me the opportunity to grow there. I joined as a Junior and gradually found my way into DevOps, taking on increasingly complex technical and organizational responsibilities until I became Team Lead. That journey shaped how I approach engineering: stay curious, take ownership, and make difficult systems understandable for the people who operate them.',
      'Consulting gave me the chance to work across cloud, hybrid, and on-premises environments, helping teams move from legacy systems toward more maintainable cloud-native platforms. I designed infrastructure with code, introduced Kubernetes and GitOps practices, improved delivery pipelines, and built observability around the systems we supported. As my role grew, I also mentored engineers and worked with senior stakeholders on strategy, partnerships, and how technical work could create lasting value for the business. Much of the day-to-day improvement came from small tools and automations in Python and Bash that removed friction from recurring operational work.',
    ],
  },
  {
    role: 'Junior Programmer (School/Work Alternation)',
    company: 'OSItalia',
    period: 'June 2018 - September 2018',
    summary: 'A school/work placement that introduced me to professional software development.',
    contributions: [
      'Applied object-oriented programming and design patterns in Delphi.',
      'Built a database management application.',
    ],
    paragraphs: [
      'My time at OSItalia was my first opportunity to see what software development looked like in a professional environment. I learned the fundamentals of programming patterns and object-oriented design with Delphi, then applied them while building a database management application. More than any specific technology, the experience taught me how much care, communication, and patience go into turning an idea into something people can actually use.',
    ],
  },
];

const skills = [
  { group: 'Cloud', items: ['AWS', 'Azure', 'GCP'] },
  { group: 'Containers & Orchestration', items: ['Kubernetes (EKS)', 'KEDA', 'Karpenter'] },
  { group: 'Infrastructure as Code', items: ['Terraform'] },
  { group: 'CI/CD', items: ['GitHub Actions', 'GitLab CI/CD', 'Jenkins', 'Azure DevOps'] },
  { group: 'GitOps & Platform Engineering', items: ['ArgoCD', 'Helm', 'Kustomize'] },
  { group: 'DevOps Practices', items: ['DevSecOps', 'Automation', 'FinOps'] },
  { group: 'Security', items: ['Container Security', 'Cloud Security', 'Kubernetes Security', 'Prowler', 'Trivy'] },
  { group: 'Observability', items: ['Grafana (LGTM)', 'Elastic Stack'] },
  { group: 'Programming & Scripting', items: ['Python', 'Bash'] },
];

const certifications = [
  { name: 'AWS Certified Solutions Architect - Associate', active: true },
  { name: 'GitLab Solutions Architect Core Verified Associate', active: true },
  { name: 'CKS: Certified Kubernetes Security Specialist', active: false },
  { name: 'CKA: Certified Kubernetes Administrator', active: false },
  { name: 'CKAD: Certified Kubernetes Application Developer', active: false },
  { name: 'KCNA: Kubernetes and Cloud Native Associate', active: false },
  { name: 'KCSA: Kubernetes and Cloud Native Security Associate', active: false },
];

const currentCertifications = certifications.filter((cert) => cert.active);
const previousCertifications = certifications.filter((cert) => !cert.active);
---

<Base
  title="Alessandro Quadrini - Senior DevOps Engineer"
  description="Portfolio of Alessandro Quadrini, Senior DevOps and Platform Engineer with 7+ years of experience building secure, scalable cloud-native platforms."
>
  <div class="container masthead">
    <h1>Alessandro Quadrini</h1>
  </div>
  <section class="hero container" aria-label="Introduction">
    <img src="/profile-portrait.png" alt="Portrait of Alessandro Quadrini" class="portrait" width="400" height="400" fetchpriority="high" />
    <div class="hero-intro">
      <p class="hero-role">Senior DevOps &amp;<br />Platform Engineer</p>
      <p class="hero-tagline">I design and run cloud-native platforms that are secure, scalable, and cost-effective.</p>
      <p class="hero-personal">You can also call me <strong>alequadro</strong>. Outside work, I enjoy gaming, working out, and music.</p>
      <ContactLinks />
    </div>
    <nav class="reading-index" aria-label="On this page">
      <h2>On this page</h2>
      <a href="#about">About me<Icon name="arrow" /></a>
      <a href="#nickname">Why AleQuadro?<Icon name="arrow" /></a>
      <a href="#life">Beyond work<Icon name="arrow" /></a>
      <a href="#experience">Experience<Icon name="arrow" /></a>
      <a href="#skills">Skills<Icon name="arrow" /></a>
      <a href="#certifications">Certifications<Icon name="arrow" /></a>
    </nav>
  </section>

  <section id="about" class="spread-section about-section container" tabindex="-1">
    <h2>About Me</h2>
    <div class="section-body prose">
      <p>I'm a Senior DevOps and Platform Engineer with 7+ years of experience designing and operating cloud-native platforms across many sectors. I've led DevOps teams and delivered secure, scalable infrastructure for enterprise and regulated environments.</p>
    </div>
  </section>
  <section id="nickname" class="spread-section nickname-section container" aria-labelledby="nickname-heading" tabindex="-1">
    <h3 id="nickname-heading">Why AleQuadro?</h3>
    <div class="section-body prose">
      <p>It's a combination of my two nicknames: Ale and Quadro. Ale is pretty self-explanatory. Quadro is a nickname my friends gave me when I moved to Tuscany in 2009. It stuck, and has been part of my identity ever since.</p>
    </div>
  </section>

  <section id="life" class="spread-section content-section container" tabindex="-1">
    <h2>Beyond Work</h2>
    <div class="section-body prose">
      <p>I developed a passion for computers at around the age of six, when my father brought home a custom-built PC. I still vividly remember the transition from floppy disks to CDs. At the time, I barely understood their purpose, but I was fascinated by every new piece of technology.</p>
      <p>Gaming has always been a big part of my life and remains one of my greatest passions. Looking back, it's what sparked my interest in computers, hardware, and software, eventually leading me toward a career in IT.</p>
      <p>Outside of work (which I believe is important to balance with personal interests!) I enjoy working out and listening to music. And yes, I'm a huge Michael Jackson fan!</p>
    </div>
  </section>

  <section id="experience" class="spread-section content-section container" tabindex="-1">
    <h2>Experience</h2>
    <div class="section-body jobs">
      {experience.map((job) => (
        <article class="job">
          <header class="job-heading">
            <div>
              <h3>{job.company}</h3>
              <p class="job-role">{job.role}</p>
            </div>
            <p class="job-period">{job.period}</p>
          </header>
          <p class="job-summary prose">{job.summary}</p>
          <ul class="job-contributions prose">
            {job.contributions.map((contribution) => <li>{contribution}</li>)}
          </ul>
          <details class="job-details">
            <summary>Read the full story<span class="sr-only"> about my role at {job.company}</span></summary>
            <div class="job-narrative prose">
              {job.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </details>
        </article>
      ))}
    </div>
  </section>

  <section id="skills" class="spread-section content-section container" tabindex="-1">
    <h2>Technical Skills</h2>
    <div class="section-body">
      <dl class="skills-list">
        {skills.map((skill) => (
          <div class="skill-row">
            <dt>{skill.group}</dt>
            <dd><ul>{skill.items.map((item) => <li>{item}</li>)}</ul></dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section id="certifications" class="spread-section content-section container" tabindex="-1">
    <h2>Certifications</h2>
    <div class="section-body">
      <article class="cert-achievement" aria-labelledby="kubestronaut-heading">
        <div class="cert-achievement-header">
          <h3 id="kubestronaut-heading"><a href="https://www.cncf.io/training/kubestronaut/" target="_blank" rel="noopener noreferrer">Kubestronaut</a></h3>
          <span class="badge badge-expired">Expired</span>
        </div>
        <p class="prose">I earned the Kubestronaut designation by completing all five CNCF Kubernetes certifications: CKA, CKAD, CKS, KCNA, and KCSA.</p>
      </article>
      <h3 class="cert-subheading">Current certifications</h3>
      <ul class="cert-list">
        {currentCertifications.map((cert) => (
          <li><span>{cert.name}</span><span class="badge">Current</span></li>
        ))}
      </ul>
      <details class="cert-history">
        <summary>Previously held certifications ({previousCertifications.length})</summary>
        <p class="cert-note prose">These Kubernetes certifications have expired. I chose not to renew them because of the combined renewal costs.</p>
        <ul class="previous-certifications prose">
          {previousCertifications.map((cert) => <li>{cert.name} <span class="sr-only">(expired)</span></li>)}
        </ul>
      </details>
    </div>
  </section>

  <section id="education" class="spread-section content-section education-section container">
    <h2>Education &amp; Languages</h2>
    <div class="section-body">
      <div>
        <h3>I.T.I.S. Tullio Buzzi</h3>
        <p class="prose">High School Degree in Computer Science and Telecommunications</p>
      </div>
      <div class="languages">
        <h3>Languages</h3>
        <p class="prose">Italian (native) &middot; English (fluent, C1)</p>
      </div>
    </div>
  </section>

  <section class="spread-section contact-section container" aria-labelledby="contact-heading">
    <h2 id="contact-heading">Let's keep<br />in touch</h2>
    <div class="section-body">
      <div class="prose">
        <p>If you'd like to talk about engineering, swap ideas, or just say hello, I'd love to hear from you.</p>
        <p>I'm always looking for stimulating challenges that keep expanding my knowledge. If you have one, I'd love to hear about it!</p>
      </div>
      <ContactLinks />
    </div>
  </section>
</Base>

<style>
  .masthead { padding-block: 1.7vw 0.6vw; border-bottom: 2px solid var(--accent); }
  .masthead h1 { font-size: clamp(2.5rem, 7.65vw, 8.5rem); line-height: 1; letter-spacing: -0.025em; text-wrap: nowrap; }
  .hero { display: grid; grid-template-columns: 25.83% minmax(0, 1fr) 19.13%; column-gap: 3.45%; padding-block: 2.2vw 1.85vw; border-bottom: 1px solid var(--border); }
  .portrait { display: block; width: 100%; height: auto; aspect-ratio: 374 / 404; object-fit: cover; border-radius: 16px; }
  .hero-role { color: var(--accent); font-family: var(--display); font-weight: 700; font-size: clamp(1.75rem, 3.3vw, 3.5rem); line-height: 1.05; letter-spacing: -0.015em; }
  .hero-tagline { max-width: 43.55vw; font-size: clamp(1.25rem, 1.9vw, 2rem); line-height: 1.3; margin-top: 1.4vw; }
  .hero-personal { max-width: 43.55vw; font-size: clamp(1.0625rem, 1.4vw, 1.5rem); line-height: 1.45; margin-top: 1.1vw; }
  .hero-intro :global(.contact-links) { margin-top: 1.1vw; gap: 1.8vw; }
  .hero-intro :global(.email-link) { min-width: 14.4vw; }
  .hero-intro :global(.contact-links a) { font-size: clamp(1rem, 1.25vw, 1.25rem); }
  .reading-index { border-left: 1px solid var(--border); padding-left: 3.1vw; padding-top: 0.5vw; }
  .reading-index h2 { font-family: var(--body); font-size: clamp(1.25rem, 1.65vw, 1.75rem); line-height: 1.25; margin-bottom: 0.7vw; letter-spacing: 0; text-wrap: nowrap; }
  .reading-index a { display: flex; align-items: center; justify-content: space-between; min-height: max(44px, 2.75vw); font-size: clamp(1rem, 1.25vw, 1.375rem); }
  :global(html:not([data-theme='dark'])) .hero-role { color: var(--text); }
  :global(html:not([data-theme='dark'])) .reading-index a { color: var(--text-muted); }
  :global(html:not([data-theme='dark'])) .reading-index a:is(:hover, :focus-visible) { color: var(--accent); }
  .reading-index :global(svg) { width: 0.85em; height: 0.85em; opacity: 0; transform: translateX(-4px); transition: opacity 180ms ease, transform 180ms cubic-bezier(0.16, 1, 0.3, 1); }
  .reading-index a:is(:hover, :focus-visible) :global(svg) { opacity: 1; transform: none; }
  .spread-section { display: grid; grid-template-columns: var(--section-label) minmax(0, 1fr); }
  .section-body { min-width: 0; border-left: 1px solid var(--border); padding-left: var(--section-inset); }
  .prose { font-size: clamp(1.0625rem, 1.3vw, 1.375rem); line-height: 1.5; }
  .prose p { max-width: 75ch; }
  .prose p + p { margin-top: 1rem; }
  .about-section { padding-block: 2.5vw 1.25vw; }
  .nickname-section { padding-block: 0.75vw 2.75vw; }
  .nickname-section h3 { font-size: clamp(1.125rem, 1.55vw, 1.625rem); padding-top: 1.2vw; }
  .nickname-section .section-body { border-left: 0; }
  .nickname-section p { border-top: 1px solid var(--border); padding-top: 1vw; }
  .content-section { border-top: 1px solid var(--border); padding-block: clamp(2.5rem, 4vw, 4.5rem); }
  .content-section > h2 { padding-right: 1.25rem; }
  #certifications > h2 { font-size: clamp(1.5rem, 2.75vw, 3rem); }
  .content-section .section-body { border-left: 0; }
  .job + .job { border-top: 1px solid var(--border); margin-top: 2.5rem; padding-top: 2.5rem; }
  .job-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem 2rem; }
  .job-heading h3 { font: 700 clamp(1.5rem, 2.1vw, 2.25rem)/1.1 var(--display); letter-spacing: -0.02em; }
  .job-role { font-size: clamp(1.0625rem, 1.25vw, 1.375rem); margin-top: 0.6rem; }
  .job-period { flex-shrink: 0; color: var(--text-muted); font-size: 1.0625rem; font-variant-numeric: tabular-nums; }
  .job-summary { margin-top: 1.5rem; max-width: 75ch; }
  .job-contributions { padding-left: 1.25rem; margin-block: 1rem 0.5rem; display: grid; gap: 0.5rem; max-width: 75ch; }
  .job-contributions li::marker { color: var(--accent); }
  :is(.job-details, .cert-history) summary { cursor: pointer; color: var(--accent); width: fit-content; min-height: 44px; padding-block: 0.65rem; font-weight: 600; }
  :is(.job-details, .cert-history) summary:hover { text-decoration: underline; text-underline-offset: 0.22em; }
  .job-narrative { margin-top: 1rem; }
  .skills-list { margin: 0; }
  .skill-row { display: grid; grid-template-columns: minmax(10rem, 37%) minmax(0, 1fr); gap: 1rem 2rem; padding-block: 1.25rem; border-bottom: 1px solid var(--border); font-size: clamp(1.0625rem, 1.25vw, 1.375rem); line-height: 1.5; }
  .skill-row:first-child { padding-top: 0; }
  .skill-row:last-child { border-bottom: 0; padding-bottom: 0; }
  .skill-row dt { font-weight: 600; }
  .skill-row dd { margin: 0; }
  .skill-row ul { display: flex; flex-wrap: wrap; gap: 0 0.3em; list-style: none; padding: 0; margin: 0; }
  .skill-row li:not(:last-child)::after { content: ','; }
  .cert-achievement { padding-bottom: 2rem; }
  .cert-achievement-header { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-bottom: 1rem; }
  .cert-achievement h3 { font: 700 clamp(1.5rem, 2.3vw, 2.5rem)/1.1 var(--display); letter-spacing: -0.02em; }
  .badge { display: inline-flex; align-items: center; align-self: center; flex-shrink: 0; font-size: 0.875rem; line-height: 1.25; padding: 0.3rem 0.6rem; color: var(--accent); border: 1px solid var(--border); border-radius: 4px; }
  .badge-expired { color: var(--text-muted); }
  .cert-subheading { font-size: 1.25rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
  .cert-list { margin: 0; padding: 0; list-style: none; }
  .cert-list li { display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-bottom: 1px solid var(--border); padding-block: 1.25rem; font-size: clamp(1.0625rem, 1.25vw, 1.375rem); line-height: 1.5; }
  .cert-history { margin-top: 1rem; }
  .cert-note { color: var(--text-muted); margin-top: 0.75rem; }
  .previous-certifications { display: grid; gap: 0.5rem; color: var(--text-muted); padding-left: 1.25rem; }
  .education-section h3 { margin-bottom: 0.75rem; }
  .languages { margin-top: 2rem; }
  .contact-section { border-top: 2px solid var(--accent); padding-block: clamp(3rem, 6vw, 6.5rem); }
  .contact-section .section-body { border-left: 0; }
  .contact-section :global(.contact-links) { margin-top: 2rem; }
  @media (max-width: 72rem) {
    .hero { grid-template-columns: 30% minmax(0, 1fr); column-gap: 4%; row-gap: 2rem; }
    .reading-index { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.5rem; padding: 1rem 0 0; border-left: 0; border-top: 1px solid var(--border); }
    .reading-index h2 { font-size: 1.25rem; margin: 0 0.5rem 0 0; }
    .reading-index a { min-height: 44px; font-size: 1.125rem; }
    .reading-index :global(svg) { display: none; }
    .hero-role { font-size: clamp(1.75rem, 3.65vw, 3rem); }
    .hero-tagline { font-size: clamp(1.25rem, 2.3vw, 1.75rem); }
    .hero-personal { font-size: clamp(1.0625rem, 1.7vw, 1.25rem); }
    .hero-tagline, .hero-personal { max-width: none; }
    .hero-intro :global(.contact-links a) { font-size: 1.0625rem; }
    .hero-intro :global(.contact-links) { gap: 1rem; }
    .job-heading { flex-direction: column; gap: 0.5rem; }
    .job-period { font-size: 1rem; }
  }
  @media (max-width: 40rem) {
    .masthead { padding-block: 1.5rem 1.25rem; }
    .masthead h1 { font-size: clamp(2.5rem, 10.5vw, 4.25rem); line-height: 0.98; text-wrap: balance; max-width: 11ch; }
    .hero { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; padding-block: 1.5rem 1.75rem; }
    .portrait { width: min(70%, 19rem); aspect-ratio: 1; }
    .hero-role { font-size: clamp(1.5rem, 6.5vw, 2.5rem); line-height: 1.1; }
    .hero-tagline { font-size: 1.25rem; line-height: 1.4; margin-top: 1.25rem; }
    .hero-personal { font-size: 1.0625rem; line-height: 1.5; margin-top: 1rem; }
    .hero-intro :global(.contact-links) { margin-top: 1.5rem; }
    .reading-index { gap: 0.25rem 1.25rem; padding-top: 1.25rem; }
    .reading-index h2 { width: 100%; margin-bottom: 0.5rem; }
    .spread-section { grid-template-columns: minmax(0, 1fr); }
    .section-body { border-left: 0; padding-left: 0; }
    .about-section { padding-block: 2rem 0.5rem; gap: 1rem; }
    .nickname-section { padding-block: 1rem 2rem; gap: 0.75rem; }
    .nickname-section h3 { padding: 0; }
    .nickname-section p { padding-top: 0; border-top: 0; }
    .prose { font-size: 1.0625rem; line-height: 1.5; }
    .content-section { gap: 1.5rem; padding-block: 2.5rem; }
    .content-section > h2 { padding-right: 0; }
    #certifications > h2 { font-size: 1.875rem; }
    .job-heading h3 { font-size: 1.5rem; }
    .job-role { font-size: 1.0625rem; }
    .job-summary { margin-top: 1rem; }
    .job + .job { margin-top: 2rem; padding-top: 2rem; }
    .skill-row { grid-template-columns: minmax(0, 1fr); gap: 0.5rem; }
    .cert-list li { align-items: start; font-size: 1.0625rem; }
    .cert-list .badge { align-self: start; margin-top: 0.15rem; }
    .contact-section { gap: 1.5rem; }
  }
  @media (prefers-reduced-motion: reduce) { .reading-index :global(svg) { transition: none; transform: none; } }
</style>
