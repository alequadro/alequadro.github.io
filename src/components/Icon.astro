---
interface Props {
  name: 'mail' | 'linkedin' | 'github' | 'resume' | 'arrow';
}
const { name } = Astro.props;
---

<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 6 9 7 9-7" /></>}
  {name === 'linkedin' && <><rect x="3" y="8" width="4" height="13" rx="0.5" /><circle cx="5" cy="3.5" r="1.5" /><path d="M11 21V8h4v2a4 4 0 0 1 7 3v8h-4v-7a1.5 1.5 0 0 0-3 0v7" /></>}
  {name === 'github' && <><path d="M9 19c-4.3 1.3-4.3-2.2-6-2.7m12 5v-3.8a3.3 3.3 0 0 0-.9-2.6c3-.3 6.2-1.5 6.2-6.8A5.3 5.3 0 0 0 19 4.5a4.9 4.9 0 0 0-.1-3.5S17.7.7 15 2.4a13.4 13.4 0 0 0-7 0C5.3.7 4.1 1 4.1 1A4.9 4.9 0 0 0 4 4.5a5.3 5.3 0 0 0-1.4 3.6c0 5.3 3.2 6.5 6.2 6.8a3.3 3.3 0 0 0-.8 2.5v3.9" /></>}
  {name === 'resume' && <><path d="M14 2H5a1 1 0 0 0-1 1v18a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V8Z" /><path d="M14 2v6h6M8 12h8M8 16h8" /></>}
  {name === 'arrow' && <path d="M5 12h14m-5-5 5 5-5 5" />}
</svg>
