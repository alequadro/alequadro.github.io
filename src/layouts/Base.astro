---
import ContactLinks from '../components/ContactLinks.astro';
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const sections = [
  { href: '#about', label: 'About Me' },
  { href: '#life', label: 'Beyond Work' },
  { href: '#experience', label: 'Experience' },
  { href: '#skills', label: 'Skills' },
  { href: '#certifications', label: 'Certifications' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/me.jpg', Astro.site)} />
    <link rel="preload" href="/fonts/special-gothic-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-sans-3-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline src="/theme.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <nav class="container nav" aria-label="Main navigation">
        <a class="logo" href="/" aria-label="Alessandro Quadrini, home">AQ</a>
        <div class="nav-links">
          {sections.map((section) => <a href={section.href}>{section.label}</a>)}
        </div>
        <details class="section-menu" data-section-menu>
          <summary>
            Sections
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </summary>
          <div class="section-menu-links">
            {sections.map((section) => <a href={section.href}>{section.label}</a>)}
          </div>
        </details>
        <button
          type="button"
          class="theme-toggle"
          data-theme-toggle
          aria-label="Toggle color theme"
          aria-pressed="false"
        >
          <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
          </svg>
          <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
        <ContactLinks compact />
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>&copy; {new Date().getFullYear()} Alessandro Quadrini &middot; Built with <a href="https://astro.build" rel="noopener">Astro</a></p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Special Gothic';
    src: url('/fonts/special-gothic-latin.woff2') format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Source Sans 3';
    src: url('/fonts/source-sans-3-latin.woff2') format('woff2');
    font-weight: 400 700;
    font-style: normal;
    font-display: swap;
  }

  :root {
    color-scheme: light;
    --bg: #f6efe2;
    --bg-soft: #eee3d2;
    --border: #d6c8b6;
    --text: #40372f;
    --text-muted: #75685a;
    --accent: #9f5831;
    --accent-soft: #f0dfce;
    --on-accent: #fff9ef;
    --display: 'Special Gothic', sans-serif;
    --body: 'Source Sans 3', sans-serif;
    --section-label: 24.8%;
    --section-inset: clamp(1.5rem, 2.2vw, 2.5rem);
  }

  [data-theme='dark'] {
    color-scheme: dark;
    --bg: #1b211f;
    --bg-soft: #252d29;
    --border: #59665e;
    --text: #f0eee4;
    --text-muted: #b6bfb4;
    --accent: #b4d6bb;
    --accent-soft: #303f35;
    --on-accent: #1b211f;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html {
    scroll-behavior: smooth;
    scroll-padding-block-start: 6rem;
    scrollbar-color: var(--text-muted) var(--bg);
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--body);
    font-size: 1.0625rem;
    line-height: 1.5;
  }
  .container { width: min(94.25%, 100rem); margin-inline: auto; }
  a { color: var(--accent); text-decoration: none; text-underline-offset: 0.22em; }
  a:hover { text-decoration: underline; }
  ::selection { background: var(--accent); color: var(--on-accent); }
  :is(a, button, summary):focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .skip-link { position: fixed; left: 1rem; top: -6rem; padding: 0.75rem 1rem; background: var(--accent); color: var(--on-accent); z-index: 100; }
  .skip-link:focus { top: 0.5rem; }
  .site-header { position: sticky; top: 0; z-index: 10; background: var(--bg); }
  .nav { position: relative; display: flex; align-items: center; gap: clamp(1rem, 2vw, 2rem); min-height: 4.875vw; border-bottom: 1px solid var(--border); }
  .logo { display: inline-flex; align-items: center; min-height: 44px; width: 7.2vw; flex-shrink: 0; border-right: 1px solid var(--border); font: 700 clamp(1.75rem, 2.85vw, 3rem)/1 var(--display); letter-spacing: -0.04em; color: var(--accent); }
  .logo:hover { text-decoration: none; }
  .nav-links { display: flex; align-items: center; gap: clamp(1rem, 2.7vw, 2.75rem); flex: 1; }
  .nav-links a { display: flex; align-items: center; min-height: 44px; color: var(--text); white-space: nowrap; font-size: clamp(1rem, 1.2vw, 1.25rem); font-weight: 600; }
  .nav-links a:hover { color: var(--accent); }
  .section-menu { display: none; margin-inline-start: auto; }
  .section-menu summary { display: flex; align-items: center; gap: 0.5rem; min-height: 44px; padding-inline: 0.75rem; border: 1px solid var(--border); border-radius: 6px; cursor: pointer; list-style: none; }
  .section-menu summary::-webkit-details-marker { display: none; }
  .section-menu summary svg { width: 1rem; height: 1rem; }
  .section-menu[open] summary svg { transform: rotate(180deg); }
  .section-menu-links { position: absolute; inset-inline: 0; top: calc(100% + 0.5rem); display: grid; padding: 0.5rem; border: 1px solid var(--border); border-radius: 6px; background: var(--bg); }
  .section-menu-links a { display: flex; align-items: center; min-height: 44px; padding: 0.5rem 0.75rem; color: var(--text); }
  .section-menu-links a:hover { background: var(--accent-soft); }
  .theme-toggle { display: grid; place-items: center; width: 48px; height: 46px; flex-shrink: 0; border: 1px solid var(--border); border-radius: 6px; background: transparent; color: var(--text); cursor: pointer; }
  .theme-toggle:hover { background: var(--accent-soft); border-color: var(--accent); }
  .theme-toggle svg { width: 24px; height: 24px; grid-area: 1 / 1; }
  .icon-moon, [data-theme='dark'] .icon-sun { display: none; }
  [data-theme='dark'] .icon-moon { display: block; }
  .contact-links { display: flex; align-items: center; gap: clamp(1rem, 2vw, 2rem); flex-wrap: wrap; }
  .contact-links a { display: inline-flex; align-items: center; justify-content: center; gap: 0.65rem; min-height: 44px; white-space: nowrap; color: var(--text); font-size: clamp(1rem, 1.25vw, 1.25rem); }
  .contact-links svg { flex-shrink: 0; width: 1.2em; height: 1.2em; }
  .contact-links .email-link { min-height: 4vw; padding: 0.6rem 2.4vw; border-radius: 8px; color: var(--on-accent); background: var(--accent); font-weight: 700; }
  .contact-links .email-link:hover { background: color-mix(in srgb, var(--accent) 88%, var(--text)); text-decoration: none; }
  .contact-links a:nth-child(2) { border-left: 1px solid var(--border); padding-left: clamp(1rem, 2vw, 2rem); }
  .contact-links-compact { flex-shrink: 0; flex-wrap: nowrap; gap: 1.5vw; padding-left: 2.2vw; border-left: 1px solid var(--border); }
  .contact-links-compact a { font-size: 1.125vw; font-weight: 600; gap: 0.5rem; }
  .contact-links-compact .email-link { min-height: 44px; padding: 0; background: transparent; color: var(--text); font-weight: 600; }
  .contact-links-compact .email-link:hover { background: transparent; text-decoration: underline; }
  .contact-links-compact a:nth-child(2) { border: 0; padding: 0; }
  h1, h2, h3, p { margin: 0; }
  h1, h2, h3 { line-height: 1.1; text-wrap: balance; }
  h1, h2 { font-family: var(--display); font-weight: 700; }
  h2 { font-size: clamp(1.875rem, 3.3vw, 3.5rem); letter-spacing: -0.025em; }
  h3 { font-size: 1.375rem; font-weight: 700; }
  .site-footer { color: var(--text-muted); font-size: 1rem; }
  .site-footer .container { display: flex; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--border); padding-block: 1.5rem; }
  @media (min-width: 106rem) { .nav { min-height: 83px; } .contact-links-compact a { font-size: 1.2rem; } }
  @media (max-width: 86rem) { .nav .contact-links-compact { display: none; } .nav { min-height: 72px; } .logo { width: 6rem; } .nav-links { justify-content: space-evenly; gap: 1rem; } }
  @media (max-width: 62rem) { .nav-links { display: none; } .section-menu { display: block; } .nav { min-height: 72px; } }
  @media (max-width: 40rem) { .container { width: calc(100% - 2.5rem); } .nav { gap: 0.75rem; } .logo { width: 4rem; } .contact-links { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.5rem 0.75rem; } .contact-links a { font-size: 1rem; gap: 0.45rem; } .contact-links .email-link { grid-column: 1 / -1; } .contact-links .email-link { min-height: 48px; padding: 0.65rem 1rem; } .contact-links a:nth-child(2) { border: 0; padding-left: 0; } .site-footer .container { flex-direction: column; gap: 0.25rem; } }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
</style>
